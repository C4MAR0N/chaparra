node_modules/
dist/
.env
.env.local
*.log
.npm-cache/
artifacts/

# Empaquetado Android (TWA)
# El keystore firma la app: si se pierde, no se puede volver a actualizar en
# Play nunca mas. No debe entrar en el repositorio bajo ningun concepto.
android/*.keystore
android/*.jks
android/keystore-password.txt
android/build/
android/.gradle/
android/app/
android/gradle*
android/*.apk
android/*.aab
android/store_icon.png
android/app-release-*

# Imágenes de las fichas de tienda: se regeneran con `npm run capturas`.
capturas/

# Documentos de clientes. El repositorio es público: una factura, un acta de
# saneamiento o un listado de crotales aquí dentro es una brecha de datos, y
# borrarlo después obliga a reescribir el historial. Ya pasó una vez con un
# acta de visita veterinaria. Estos archivos van a Chaparra-privado.
*.pdf
*.xlsx
*.xls
*.csv
